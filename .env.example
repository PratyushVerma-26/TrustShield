# ==============================================================================
# TrustShield Cyber-Defense Platform - Production Environment Template
# ==============================================================================
# Copy this file to '.env' and populate with your production or test API keys.
# All microservices run with sensible offline defaults if external keys are omitted.

# ------------------------------------------------------------------------------
# 1. Platform & Network Topology
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080

# ------------------------------------------------------------------------------
# 2. Phishing Shield & URL Reputation
# ------------------------------------------------------------------------------
# Google Safe Browsing API v4 key (Optional: provides cloud reputation enrichment)
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal v3 API key (Optional: provides global threat intelligence feeds)
VIRUSTOTAL_API_KEY=

# ------------------------------------------------------------------------------
# 3. Credential Breach Monitor
# ------------------------------------------------------------------------------
# Have I Been Pwned API Key (Optional: for full email breach history lookups)
# Note: Password k-anonymity search against 800M+ SHA-1 digests operates freely
# without an API key.
HIBP_API_KEY=

# ------------------------------------------------------------------------------
# 4. Misinformation & Fact-Check Directory
# ------------------------------------------------------------------------------
# Google Fact Check Tools API Key (Optional: for live search against global debunkers)
# The platform ships with a bundled offline SimHash debunk catalog that operates
# with zero external connectivity.
GOOGLE_FACT_CHECK_API_KEY=

# ------------------------------------------------------------------------------
# 5. Cyber-Defense Conversational Bot (WhatsApp & Telegram)
# ------------------------------------------------------------------------------
# Secret verification token configured in the Meta for Developers webhook dashboard
WHATSAPP_VERIFY_TOKEN=trustshield_webhook_token_2026

# Meta WhatsApp Cloud API permanent or temporary System User Access Token
WHATSAPP_TOKEN=

# WhatsApp Business Account Phone Number ID (from Meta Developer portal)
WHATSAPP_PHONE_NUMBER_ID=

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------------------------
# 6. Frontend Clients Configuration
# ------------------------------------------------------------------------------
# Unified API Gateway public endpoint for Web Console (Vite)
VITE_GATEWAY_URL=http://localhost:8080

# Unified API Gateway public endpoint for Mobile App (Expo / React Native)
EXPO_PUBLIC_GATEWAY_URL=http://localhost:8080
